# Chatbot (NVIDIA-hosted model)
NVIDIA_API_KEY=

# Contact form
WEB3FORMS_KEY=

# GitHub activity graph (api/github.js).
# Needs a fine-grained PAT with NO scopes selected: the contribution calendar
# is public data, but GitHub's GraphQL API requires authentication regardless.
# Create at https://github.com/settings/tokens
# Without this the Activity section hides itself rather than erroring.
GITHUB_TOKEN=
